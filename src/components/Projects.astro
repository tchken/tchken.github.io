---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <div id="projects" class="background-alt">
    <div class="container">
      <div class="row">
        <div class="col-full">
          <h2 class="heading">Projects</h2>
        </div>
      </div>
      <div class="projects-list">
        {siteConfig.projects.map((project) => (
          <div class="project shadow-large" style={`--accent: ${project.accentColor || '#3498db'};`}>
            {project.image && (
              <div class="project-image">
                <img src={project.image} alt={project.name} />
              </div>
            )}
            <div class="project-info">
              {project.category && (
                <span class="project-category">{project.category}</span>
              )}
              <h3>{project.name}</h3>
              {project.tagline && (
                <p class="project-tagline">{project.tagline}</p>
              )}
              <p class="project-description">{project.description}</p>

              {project.pipeline && project.pipeline.length > 0 && (
                <div class="pipeline">
                  <span class="badge-label">How It Works</span>
                  {project.pipeline.map((p) => (
                    <div class="pipeline-step">
                      <span class="step-label">{p.step}</span>
                      <span class="step-detail">{p.detail}</span>
                    </div>
                  ))}
                </div>
              )}

              {project.results && (
                <div class="results">
                  <span class="badge-label">Results</span>
                  <table>
                    <thead>
                      <tr>{project.results.headers.map((h) => <th>{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {project.results.rows.map((row) => (
                        <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                      ))}
                    </tbody>
                  </table>
                  {project.results.caption && <p class="results-caption">{project.results.caption}</p>}
                  {project.results.footnote && <p class="results-footnote">{project.results.footnote}</p>}
                </div>
              )}

              {project.glossary && project.glossary.length > 0 && (
                <div class="glossary">
                  <span class="badge-label">Key Terms</span>
                  <div class="glossary-list">
                    {project.glossary.map((g) => (
                      <span class="glossary-term">
                        {g.term}
                        <span class="tooltip">
                          <span class="tooltip-inner">
                            {g.definition}
                            {g.link && (
                              <a href={g.link} target="_blank" rel="noopener noreferrer">
                                Learn more →
                              </a>
                            )}
                          </span>
                        </span>
                      </span>
                    ))}
                  </div>
                </div>
              )}

              {project.tools && project.tools.length > 0 && (
                <div class="badge-group">
                  <span class="badge-label">Tools &amp; Libraries</span>
                  <div class="badge-list">
                    {project.tools.map((t) => (
                      <span class="badge badge-tool">{t}</span>
                    ))}
                  </div>
                </div>
              )}

              {project.methods && project.methods.length > 0 && (
                <div class="badge-group">
                  <span class="badge-label">Methods</span>
                  <div class="badge-list">
                    {project.methods.map((m) => (
                      <span class="badge badge-method">{m}</span>
                    ))}
                  </div>
                </div>
              )}

              {project.links && project.links.length > 0 && (
                <div class="project-links">
                  {project.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  #projects {
    padding: 75px 15px;
    border-bottom: 1px solid #dcd9d9;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .col-full {
    text-align: center;
    margin-bottom: 30px;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .project {
    background: #fff;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    border-left: 15px solid var(--accent, #3498db);
  }

  .project-image {
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .project-info {
    padding: 30px;
  }

  .project-category {
    display: inline-block;
    font-size: 0.78em;
    font-weight: 600;
    color: #3498db;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .project-info h3 {
    font-size: 1.5em;
    font-weight: 600;
    color: #374054;
    margin: 0 0 8px 0;
  }

  .project-tagline {
    font-size: 1em;
    font-weight: 500;
    font-style: italic;
    color: #374054;
    line-height: 1.5em;
    margin: 0 0 16px 0;
  }

  .project-description {
    color: #74808a;
    font-size: 0.95em;
    line-height: 1.7em;
    margin: 0 0 20px 0;
  }

  .pipeline {
    margin-bottom: 20px;
  }

  .pipeline-step {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .pipeline-step:last-child {
    border-bottom: none;
  }

  .step-label {
    font-size: 0.82em;
    font-weight: 700;
    color: #2980b9;
    min-width: 90px;
    padding-top: 1px;
  }

  .step-detail {
    font-size: 0.85em;
    color: #74808a;
    line-height: 1.6em;
  }

  .results {
    margin-bottom: 20px;
    overflow-x: auto;
  }

  .results table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.83em;
    margin-top: 8px;
  }

  .results th {
    background: #f4f7fb;
    color: #374054;
    font-weight: 600;
    padding: 7px 12px;
    text-align: left;
    border: 1px solid #e0e6ed;
  }

  .results td {
    padding: 6px 12px;
    border: 1px solid #e0e6ed;
    color: #74808a;
  }

  .results tr:last-child td {
    font-weight: 600;
    color: #2980b9;
    background: #f0f8ff;
  }

  .results-caption {
    font-size: 0.75em;
    color: #a0aab4;
    margin-top: 6px;
    margin-bottom: 2px;
  }

  .results-footnote {
    font-size: 0.75em;
    color: #a0aab4;
    margin: 0;
  }

  .glossary {
    margin-bottom: 20px;
  }

  .glossary-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }


  .badge-group {
    margin-bottom: 14px;
  }

  .badge-label {
    display: block;
    font-size: 0.75em;
    font-weight: 600;
    color: #374054;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .badge {
    display: inline-block;
    font-size: 0.78em;
    padding: 4px 10px;
    border-radius: 3px;
    font-weight: 500;
  }

  .badge-tool {
    background: #e8f4fd;
    color: #2980b9;
    border: 1px solid #bee3f8;
  }

  .badge-method {
    background: #f0f4ff;
    color: #4a5568;
    border: 1px solid #c3cfe2;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .project-links a {
    color: #3498db;
    font-size: 0.88em;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid #3498db;
    padding: 6px 16px;
    border-radius: 3px;
    transition: 0.2s ease;
  }

  .project-links a:hover {
    background: #3498db;
    color: #fff;
  }

</style>

<style is:global>
  .glossary-term {
    position: relative;
    font-size: 0.82em;
    font-weight: 600;
    color: #374054;
    border-bottom: 2px dotted #3498db;
    cursor: help;
    padding-bottom: 1px;
  }

  .glossary-term .tooltip {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 220px;
    padding-bottom: 8px;
    z-index: 9999;
  }

  .glossary-term .tooltip-inner {
    display: block;
    background: #1a2332;
    color: #f0f4f8;
    font-size: 0.8em;
    line-height: 1.5em;
    padding: 10px 12px;
    border-radius: 5px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }

  .glossary-term .tooltip a {
    display: block;
    margin-top: 8px;
    color: #5dade2;
    font-weight: 600;
    text-decoration: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 6px;
  }

  .glossary-term .tooltip a:hover {
    text-decoration: underline;
  }

  .glossary-term:hover .tooltip,
  .glossary-term .tooltip:hover {
    display: block;
  }
</style>

